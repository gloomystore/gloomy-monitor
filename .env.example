# App
PORT=3000

# MySQL — the database itself must already exist, tables are created automatically on first start
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=site_monitor
DB_PASS=change-me
DB_NAME=site_monitor

# Outgoing mail — requires a working `sendmail`-compatible binary on PATH
# (postfix, msmtp, ssmtp, etc. all provide one). This app does not talk SMTP itself.
MAIL_FROM=alerts@example.com
# SENDMAIL_PATH=sendmail

# Basic Auth — required to access the dashboard. Leave unset to disable auth (not recommended).
AUTH_USER=admin
AUTH_PASSWORD=change-me
